# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Supabase → your project → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Websites allowed to call the API from a browser (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173
